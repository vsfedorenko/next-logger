{
  "name": "next-logger-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/next-logger",
    "e2e/fixture",
    "e2e/fixture-pino",
    "e2e/fixture-winston"
  ],
  "scripts": {
    "build": "bun run --filter '@vsfedorenko/next-logger' build",
    "lint": "bun run --filter '@vsfedorenko/next-logger' lint",
    "typecheck": "bun run --filter '@vsfedorenko/next-logger' typecheck",
    "test": "bun run --filter '@vsfedorenko/next-logger' test",
    "test:e2e": "bun run build && bun run --filter '@vsfedorenko/next-logger' test:e2e",
    "test:coverage": "bun run --filter '@vsfedorenko/next-logger' test:coverage"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vsfedorenko/next-logger": "workspace:*",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
